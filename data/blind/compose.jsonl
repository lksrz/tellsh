{"text": "find files in ./build not modified in 10 days and delete them", "lang": "en", "tool": "find", "gold": "find ./build -type f -mtime +10 -delete", "acceptable": ["find ./build -mtime +10 -type f -delete"]}
{"text": "znajdź pliki .tmp w /tmp/sesje starsze niż 3 dni i pokaż je ze szczegółami", "lang": "pl", "tool": "find", "gold": "find /tmp/sesje -type f -name '*.tmp' -mtime +3 -ls", "acceptable": ["find /tmp/sesje -type f -iname '*.tmp' -mtime +3 -ls", "find /tmp/sesje -type f -name '*.tmp' -mtime +3 -exec ls -l {} +"]}
{"text": "find files owned by user deploy with permissions 777 under /var/www", "lang": "en", "tool": "find", "gold": "find /var/www -type f -user deploy -perm 777", "acceptable": ["find /var/www -user deploy -type f -perm 777", "find /var/www -type f -perm 777 -user deploy", "find /var/www -user deploy -perm 777"]}
{"text": "grep case-insensitively for timeout in all .yaml files under ./k8s, show line numbers", "lang": "en", "tool": "grep", "gold": "grep -r -i -n --include='*.yaml' timeout ./k8s", "acceptable": ["grep -r -n -i --include='*.yaml' timeout ./k8s", "grep -rin --include='*.yaml' timeout ./k8s", "grep -r -i -n --include=*.yaml timeout ./k8s"]}
{"text": "wyszukaj słowo deadlock w /var/log/pg ignorując wielkość liter i pokaż 3 linie kontekstu", "lang": "pl", "tool": "grep", "gold": "grep -r -i -C 3 deadlock /var/log/pg", "acceptable": ["grep -r -i -C3 deadlock /var/log/pg", "grep -ri -C 3 deadlock /var/log/pg", "grep -r -C 3 -i deadlock /var/log/pg"]}
