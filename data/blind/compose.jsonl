{"text": "list files sorted by size, smallest first, human readable sizes", "lang": "en", "tool": "ls", "gold": "ls -l -S -r -h", "acceptable": ["ls -l -h -S -r", "ls -lShr", "ls -lhSr", "ls -l -r -S -h"]}
{"text": "pokaż pliki posortowane po rozmiarze od najmniejszego, rozmiary czytelne dla człowieka", "lang": "pl", "tool": "ls", "gold": "ls -l -S -r -h", "acceptable": ["ls -l -h -S -r", "ls -lShr", "ls -lhSr"]}
{"text": "list all files including dotfiles in long format, newest first", "lang": "en", "tool": "ls", "gold": "ls -l -a -t", "acceptable": ["ls -a -l -t", "ls -lat", "ls -alt", "ls -l -A -t"]}
{"text": "wylistuj /srv/media ze szczegółami, najnowsze na końcu", "lang": "pl", "tool": "ls", "gold": "ls -l -t -r /srv/media", "acceptable": ["ls -l -r -t /srv/media", "ls -ltr /srv/media", "ls -l -t -r -h /srv/media"]}
{"text": "list only directories in /opt, one per line", "lang": "en", "tool": "ls", "gold": "ls -1 -d /opt/*/", "acceptable": ["ls -d -1 /opt/*/", "ls -1d /opt/*/"]}
{"text": "ls rekurencyjnie katalogu config z ukrytymi plikami", "lang": "pl", "tool": "ls", "gold": "ls -R -a config", "acceptable": ["ls -a -R config", "ls -Ra config", "ls -R -A config"]}
{"text": "find .log files bigger than 50MB in /var/lib/app modified in the last 2 days", "lang": "en", "tool": "find", "gold": "find /var/lib/app -type f -name '*.log' -size +50M -mtime -2", "acceptable": ["find /var/lib/app -type f -iname '*.log' -size +50M -mtime -2", "find /var/lib/app -name '*.log' -type f -size +50M -mtime -2"]}
