{"text": "pokaż metadane pliku /etc/shadow-", "intent": "file_stat", "lang": "pl", "spans": [["PATH", "/etc/shadow-"]]}
{"text": "pierwsze 3 linie pliku nagłówki.tsv", "intent": "head_file", "lang": "pl", "spans": [["NUM", "3"], ["PATH", "nagłówki.tsv"]]}
{"text": "ostatnie pięćdziesiąt linii /var/log/syslog.1", "intent": "tail_file", "lang": "pl", "spans": [["NUM", "pięćdziesiąt"], ["PATH", "/var/log/syslog.1"]]}
{"text": "śledź na żywo plik /var/log/qzx/zdarzenia.log", "intent": "tail_follow", "lang": "pl", "spans": [["PATH", "/var/log/qzx/zdarzenia.log"]]}
{"text": "wyświetl plik ~/.ssh/known_hosts", "intent": "cat_file", "lang": "pl", "spans": [["PATH", "~/.ssh/known_hosts"]]}
{"text": "spakuj katalog /home/marta/projekty do projekty.tar.gz", "intent": "compress_targz", "lang": "pl", "spans": [["PATH", "/home/marta/projekty"], ["PATH", "projekty.tar.gz"]]}
{"text": "rozpakuj kopia_2024-05-01.tgz do /srv/restore", "intent": "extract_targz", "lang": "pl", "spans": [["PATH", "kopia_2024-05-01.tgz"], ["PATH", "/srv/restore"]]}
{"text": "zrób zipa z folderu faktury_marzec", "intent": "compress_zip", "lang": "pl", "spans": [["PATH", "faktury_marzec"]]}
{"text": "wypakuj sterowniki_v3.zip do Pobranych", "intent": "extract_zip", "lang": "pl", "spans": [["PATH", "sterowniki_v3.zip"], ["PATH", "Pobranych"]]}
{"text": "co jest w archiwum backup_bazy.tar.gz", "intent": "list_archive", "lang": "pl", "spans": [["PATH", "backup_bazy.tar.gz"]]}
{"text": "ustaw prawa 600 na pliku ~/.netrc", "intent": "chmod", "lang": "pl", "spans": [["MODE", "600"], ["PATH", "~/.netrc"]]}
{"text": "nadaj g+w katalogowi /srv/wspolne", "intent": "chmod", "lang": "pl", "spans": [["MODE", "g+w"], ["PATH", "/srv/wspolne"]]}
{"text": "zrób plik skrypty/wdrozenie.sh wykonywalnym", "intent": "make_executable", "lang": "pl", "spans": [["PATH", "skrypty/wdrozenie.sh"]]}
{"text": "zmień właściciela /var/lib/qzx na użytkownika qzxsvc", "intent": "chown", "lang": "pl", "spans": [["PATH", "/var/lib/qzx"], ["USER", "qzxsvc"]]}
{"text": "skopiuj plik env.example do .env.local", "intent": "copy", "lang": "pl", "spans": [["PATH", "env.example"], ["PATH", ".env.local"]]}
{"text": "przenieś zdjęcie IMG_2231.HEIC do ~/Obrazy/wakacje", "intent": "move_rename", "lang": "pl", "spans": [["PATH", "IMG_2231.HEIC"], ["PATH", "~/Obrazy/wakacje"]]}
{"text": "zmień nazwę stary_raport.xlsx na raport_q1.xlsx", "intent": "move_rename", "lang": "pl", "spans": [["PATH", "stary_raport.xlsx"], ["PATH", "raport_q1.xlsx"]]}
{"text": "usuń plik /tmp/blokada.lock", "intent": "delete_file", "lang": "pl", "spans": [["PATH", "/tmp/blokada.lock"]]}
{"text": "skasuj katalog build-artefakty razem z zawartością", "intent": "delete_dir", "lang": "pl", "spans": [["PATH", "build-artefakty"]]}
{"text": "usuń wszystkie pliki .bak z /etc/qzx", "intent": "delete_by_ext", "lang": "pl", "spans": [["EXT", ".bak"], ["PATH", "/etc/qzx"]]}
{"text": "utwórz katalog /srv/kopie/2025/styczeń", "intent": "mkdir", "lang": "pl", "spans": [["PATH", "/srv/kopie/2025/styczeń"]]}
{"text": "stwórz pusty plik notatki_spotkanie.md", "intent": "touch_file", "lang": "pl", "spans": [["PATH", "notatki_spotkanie.md"]]}
{"text": "zamień \"Kowalski\" na \"Nowak\" w pliku umowa.txt", "intent": "replace_text", "lang": "pl", "spans": [["PATTERN", "Kowalski"], ["REPL", "Nowak"], ["PATH", "umowa.txt"]]}
{"text": "w config.ini podmień port=8080 na port=9443", "intent": "replace_text", "lang": "pl", "spans": [["PATH", "config.ini"], ["PATTERN", "port=8080"], ["REPL", "port=9443"]]}
{"text": "policz sha256 pliku obraz_systemu.img", "intent": "hash_sha256", "lang": "pl", "spans": [["PATH", "obraz_systemu.img"]]}
{"text": "suma md5 dla /var/backups/baza.sql.gz", "intent": "hash_md5", "lang": "pl", "spans": [["PATH", "/var/backups/baza.sql.gz"]]}
{"text": "zakoduj w base64 tekst \"zażółć gęślą jaźń\"", "intent": "base64_encode", "lang": "pl", "spans": [["TEXT", "zażółć gęślą jaźń"]]}
{"text": "odkoduj z base64 a3J6YWs=", "intent": "base64_decode", "lang": "pl", "spans": [["TEXT", "a3J6YWs="]]}
{"text": "6 procesów najbardziej obciążających procesor", "intent": "top_cpu", "lang": "pl", "spans": [["NUM", "6"]]}
{"text": "pokaż trzy procesy zjadające najwięcej ramu", "intent": "top_mem", "lang": "pl", "spans": [["NUM", "trzy"]]}
{"text": "czy działa proces krzak-sync", "intent": "find_process", "lang": "pl", "spans": [["NAME", "krzak-sync"]]}
{"text": "znajdź proces celery", "intent": "find_process", "lang": "pl", "spans": [["NAME", "celery"]]}
{"text": "zabij wszystkie procesy qzx-scraper", "intent": "kill_by_name", "lang": "pl", "spans": [["NAME", "qzx-scraper"]]}
{"text": "ubij siłowo proces Xorg", "intent": "kill_force", "lang": "pl", "spans": [["NAME", "Xorg"]]}
{"text": "zakończ proces o PID 7731", "intent": "kill_by_pid", "lang": "pl", "spans": [["PID", "7731"]]}
{"text": "zabij proces na porcie 8888", "intent": "kill_by_port", "lang": "pl", "spans": [["PORT", "8888"]]}
{"text": "co słucha na porcie 9200", "intent": "process_on_port", "lang": "pl", "spans": [["PORT", "9200"]]}
{"text": "logi usługi qzx-agent z ostatnich 30 minut", "intent": "journal_service", "lang": "pl", "spans": [["NAME", "qzx-agent"], ["TIME", "ostatnich 30 minut"]]}
{"text": "pokaż logi sshd od wczoraj", "intent": "journal_service", "lang": "pl", "spans": [["NAME", "sshd"], ["TIME", "wczoraj"]]}
{"text": "status usługi krzak-api", "intent": "service_status", "lang": "pl", "spans": [["NAME", "krzak-api"]]}
{"text": "zrestartuj usługę nginx", "intent": "service_restart", "lang": "pl", "spans": [["NAME", "nginx"]]}
{"text": "uruchom usługę mariadb", "intent": "service_start", "lang": "pl", "spans": [["NAME", "mariadb"]]}
{"text": "zatrzymaj usługę cups-browsed", "intent": "service_stop", "lang": "pl", "spans": [["NAME", "cups-browsed"]]}
{"text": "zainstaluj pakiet python3-venv", "intent": "install_package", "lang": "pl", "spans": [["NAME", "python3-venv"]]}
{"text": "czy jest zainstalowany pakiet wireguard-tools", "intent": "package_installed", "lang": "pl", "spans": [["NAME", "wireguard-tools"]]}
{"text": "jaka jest wartość zmiennej JAVA_HOME", "intent": "env_var_get", "lang": "pl", "spans": [["VAR", "JAVA_HOME"]]}
{"text": "gdzie jest polecenie kubectl", "intent": "which_cmd", "lang": "pl", "spans": [["NAME", "kubectl"]]}
{"text": "znajdź w historii komendę z \"docker run\"", "intent": "history_search", "lang": "pl", "spans": [["PATTERN", "docker run"]]}
{"text": "pingnij 192.168.88.1 trzy razy", "intent": "ping_host", "lang": "pl", "spans": [["HOST", "192.168.88.1"], ["NUM", "trzy"]]}
{"text": "sprawdź dns dla sklep-krzak.pl", "intent": "dns_lookup", "lang": "pl", "spans": [["HOST", "sklep-krzak.pl"]]}
{"text": "czy port 5432 na db-replika-2 jest otwarty", "intent": "port_check", "lang": "pl", "spans": [["PORT", "5432"], ["HOST", "db-replika-2"]]}
{"text": "nagłówki http dla https://www.gov.pl", "intent": "curl_headers", "lang": "pl", "spans": [["URL", "https://www.gov.pl"]]}
{"text": "jaki kod zwraca https://api.krzak.io/v1/health", "intent": "http_status", "lang": "pl", "spans": [["URL", "https://api.krzak.io/v1/health"]]}
{"text": "pobierz https://mirror.example.pl/obrazy/alpine-3.20.iso", "intent": "download_file", "lang": "pl", "spans": [["URL", "https://mirror.example.pl/obrazy/alpine-3.20.iso"]]}
{"text": "połącz się przez ssh z admin@10.8.0.14", "intent": "ssh_connect", "lang": "pl", "spans": [["HOST", "admin@10.8.0.14"]]}
{"text": "ostatnie 12 commitów", "intent": "git_log", "lang": "pl", "spans": [["NUM", "12"]]}
{"text": "utwórz gałąź poprawka/KRZ-404-koszyk", "intent": "git_new_branch", "lang": "pl", "spans": [["BRANCH", "poprawka/KRZ-404-koszyk"]]}
{"text": "przełącz się na gałąź develop", "intent": "git_switch_branch", "lang": "pl", "spans": [["BRANCH", "develop"]]}
{"text": "usuń brancha eksperyment_qzx", "intent": "git_delete_branch", "lang": "pl", "spans": [["BRANCH", "eksperyment_qzx"]]}
{"text": "wypchnij gałąź feature/platnosci-blik na origin", "intent": "git_push", "lang": "pl", "spans": [["BRANCH", "feature/platnosci-blik"]]}
{"text": "zrób commit z wiadomością \"poprawka walidacji NIP\"", "intent": "git_commit", "lang": "pl", "spans": [["MSG", "poprawka walidacji NIP"]]}
{"text": "sklonuj https://github.com/krzak/narzedzia.git", "intent": "git_clone", "lang": "pl", "spans": [["URL", "https://github.com/krzak/narzedzia.git"]]}
{"text": "pokaż zmiany w pliku src/koszyk.ts", "intent": "git_diff", "lang": "pl", "spans": [["PATH", "src/koszyk.ts"]]}
{"text": "logi kontenera qzx-ingest-7", "intent": "docker_logs", "lang": "pl", "spans": [["NAME", "qzx-ingest-7"]]}
{"text": "zatrzymaj kontener stary_redis", "intent": "docker_stop", "lang": "pl", "spans": [["NAME", "stary_redis"]]}
{"text": "wejdź do kontenera krzak-web-1", "intent": "docker_exec", "lang": "pl", "spans": [["NAME", "krzak-web-1"]]}
